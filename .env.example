# 複製為 .env 後填入；.env 已列入 .gitignore，不可提交
APP_ENV=dev
JWT_SECRET=請改成至少32字元的隨機字串-例如-python-c-import-secrets-print-secrets.token_urlsafe-48
POSTGRES_PASSWORD=dineflow

# LINE Messaging API（LINE Developers Console > Messaging API channel > Channel access token）
LINE_CHANNEL_ACCESS_TOKEN=

# LINE Pay Sandbox（https://pay.line.me 申請 sandbox 商家帳號）
LINEPAY_CHANNEL_ID=
LINEPAY_CHANNEL_SECRET=
LINEPAY_API_BASE=https://sandbox-api-pay.line.me
